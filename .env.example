# Copy to .env (repo root) and fill in. .env is gitignored.

# --- LLM structured extraction (default provider: gemini) -------------------
# Options: gemini | anthropic | openai_compat | none   (none = deterministic parsing only)
MEDNIK_LLM_PROVIDER=gemini
GEMINI_API_KEY=
MEDNIK_GEMINI_MODEL=gemini-3.8-flash

# ANTHROPIC_API_KEY=
# MEDNIK_ANTHROPIC_MODEL=claude-sonnet-5-5

# Local / self-hosted OpenAI-compatible server (e.g. Ollama) — keeps PDFs on-prem
# MEDNIK_OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# MEDNIK_OPENAI_COMPAT_MODEL=llama3.1:8b-instruct-q4_K_M
# MEDNIK_OPENAI_COMPAT_API_KEY=

MEDNIK_LLM_MAX_CONCURRENCY=4

# --- Public API politeness (optional keys raise rate limits) ----------------
MEDNIK_CONTACT_EMAIL=you@example.com
# NCBI_API_KEY=          # https://www.ncbi.nlm.nih.gov/account/settings/ (3 → 10 req/s)
# OPENFDA_API_KEY=       # https://open.fda.gov/apis/authentication/

# --- Storage -------------------------------------------------------------------
# MEDNIK_DATABASE_URL=sqlite:///./mednik.db
# MEDNIK_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/mednik
MEDNIK_CACHE_TTL_HOURS=168

# --- Ingestion limits ------------------------------------------------------------
MEDNIK_MAX_TRIALS_PER_QUERY=300
MEDNIK_MAX_PUBMED_PER_QUERY=150
MEDNIK_MAX_EPMC_PER_QUERY=150

# --- Frontend ----------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE=   (leave unset: the dashboard proxies /api to the backend)
MEDNIK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
